    "/v1/provider/payments": {
      "post": {
        "operationId": "ProviderController_create",
        "parameters": [
          {
            "name": "X-Signature",
            "in": "header",
            "required": true,
            "description": "Hex HMAC-SHA256 signature of the request.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Signature-Timestamp",
            "in": "header",
            "required": true,
            "description": "Unix seconds; accepted within ±5 minutes.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Signed as sent; empty when absent.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          },
          "401": {
            "description": "`signature.invalid`: forged or stale signature.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "default": {
            "description": "Error envelope (A7): branch on `code`, never on `message`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "tags": [
          "provider"
        ],
        "security": [],
        "description": "Service-to-service call signed by `core` (P3): HMAC-SHA256 over `timestamp.method.path.idempotencyKey.body`."
      }
    },
    "/v1/provider/payments/{id}": {
      "get": {
        "operationId": "ProviderController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "minLength": 1,
              "maxLength": 64,
              "type": "string"

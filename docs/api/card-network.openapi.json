  "info": {
    "title": "Acme Credit — card network API",
    "description": "The simulated card network: in-wallet checkout, purchases and voids (forwarded to the lending core, signed), and the simulated payment provider (signed by the core) with its hosted pay page. Amounts are strings of integer cents. Every error is the `ErrorEnvelope`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "provider"
    },
    {
      "name": "purchases"
    }
  ],
  "servers": [
    {
      "url": "/",
      "description": "This server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token"
      }
    },
    "schemas": {
      "PurchaseRequestDto": {
        "type": "object",
        "properties": {
          "cardToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "amountCents": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,14}$"
          },
          "merchant": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "mcc": {
                "type": "string",
                "pattern": "^\\d{4}$"
              }
            },
            "required": [
              "name",
              "mcc"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "cardToken",
          "amountCents",
          "merchant"
        ],
        "additionalProperties": false
      },
      "VoidPurchaseRequestDto": {
        "type": "object",
        "properties": {
          "cardToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "cardToken"
        ],
        "additionalProperties": false
      },
      "CheckoutRequestDto": {
        "type": "object",
        "properties": {
          "cardToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "merchant": {
            "type": "string",
            "enum": [
              "taqueria",
              "market",
              "electro",
              "casa"
            ]
          },
          "items": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              },
              "required": [
                "sku",
                "quantity"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "cardToken",
          "merchant",
          "items"
        ],
        "additionalProperties": false
      },
      "CreatePaymentDto": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "amountCents": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,14}$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "deposit",
              "repayment",
              "payout"
            ]
          }
        },
        "required": [
          "reference",
          "amountCents",
          "purpose"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "common.validation_failed",
              "common.not_found",
              "common.unauthenticated",
              "common.forbidden",
              "common.rate_limited",
              "common.conflict",
              "common.internal",
              "common.payload_too_large",
              "auth.invalid_credentials",
              "auth.email_taken",
              "auth.session_expired",
              "idempotency.key_required",
              "idempotency.key_reused",
              "idempotency.in_progress",
              "operation.in_progress",
              "signature.invalid",
              "account.already_open",
              "account.not_active",
              "account.not_frozen",
              "account.closed",
              "account.pending_holds",
              "deposit.amount_out_of_range",
              "repayment.exceeds_debt",
              "repayment.no_debt",
              "payment.not_confirmed",
              "payment.provider_unavailable",
              "authorization.not_capturable",
              "authorization.not_reversible",
              "authorization.capture_exceeds_hold",
              "authorization.hold_released",
              "account.frozen_by_admin",
              "payment.deposit_cap_exceeded"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "additionalProperties": false,
        "description": "One envelope for every error. Codes: common.validation_failed, common.not_found, common.unauthenticated, common.forbidden, common.rate_limited, common.conflict, common.internal, common.payload_too_large, auth.invalid_credentials, auth.email_taken, auth.session_expired, idempotency.key_required, idempotency.key_reused, idempotency.in_progress, operation.in_progress, signature.invalid, account.already_open, account.not_active, account.not_frozen, account.closed, account.pending_holds, deposit.amount_out_of_range, repayment.exceeds_debt, repayment.no_debt, payment.not_confirmed, payment.provider_unavailable, authorization.not_capturable, authorization.not_reversible, authorization.capture_exceeds_hold, authorization.hold_released, account.frozen_by_admin, payment.deposit_cap_exceeded."
      }
    }
  }
}

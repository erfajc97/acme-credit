    "/v1/purchases/{authorizationId}/void": {
      "post": {
        "operationId": "PurchasesController_void",
        "parameters": [
          {
            "name": "authorizationId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "A client-generated UUID. A retry with the same key and body replays the first answer (MO2).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoidPurchaseRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Error envelope (A7): branch on `code`, never on `message`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "tags": [
          "purchases"
        ],
        "security": []
      }
    },

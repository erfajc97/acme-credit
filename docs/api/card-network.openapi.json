                }
              }
            }
          },
          "default": {
            "description": "Error envelope (A7): branch on `code`, never on `message`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "tags": [
          "provider"
        ],
        "security": [],
        "description": "Service-to-service call signed by `core` (P3): HMAC-SHA256 over `timestamp.method.path.idempotencyKey.body`."
      }
    },

# Local configuration. `pnpm docker:up` creates .env from this file on the first run.
# Placeholders only — never commit real values (G9). Each service validates what it reads at
# boot (apps/*/src/core/config/env.ts).

# --- host ports (everything binds to 127.0.0.1) ---
API_PORT=3000
NETWORK_PORT=3001
WEB_PORT=4321
ADMIN_PORT=4322
# 5434 avoids clashing with a local Postgres on 5432.
POSTGRES_HOST_PORT=5434
S3_HOST_PORT=9000
S3_CONSOLE_HOST_PORT=9001

# --- infrastructure (docker compose) ---
POSTGRES_USER=acme
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=acme_credit
S3_ACCESS_KEY=acme
S3_SECRET_KEY=change-me-local
S3_BUCKET=acme-statements

# --- api (lending core) and card-network, when run with `pnpm --filter <app> dev` ---
NODE_ENV=development
LOG_LEVEL=info
# Each service uses its own PORT (api 3000, card-network 3001) when unset.
# PORT=3000
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:4321,http://localhost:4322
# Used by `pnpm --filter @acme/api dev` (compose builds its own URL to the postgres service).
DATABASE_URL=postgresql://acme:change-me-local@localhost:5434/acme_credit

# --- shared secrets (≥ 32 chars). `pnpm docker:up` replaces every <generate> with a random
# value when it creates .env; the services refuse placeholders in production. ---
JWT_SECRET=<generate>
# card-network → core (network authorizations)
NETWORK_SIGNING_SECRET=<generate>
# payment provider simulator → core (webhooks)
PROVIDER_SIGNING_SECRET=<generate>
# core → payment provider simulator (create / read payments)
PROVIDER_API_SECRET=<generate>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Development only (plain-http localhost). With NODE_ENV=production the refresh cookie is always
# Secure and COOKIE_SECURE=false refuses to boot (docker compose does not pass it).
COOKIE_SECURE=false
PROVIDER_API_URL=http://localhost:3001
# An approved hold nobody captured is released after this many hours (stored per hold).
HOLD_TTL_HOURS=168
# A deposit or repayment not approved at the bank within this many minutes stops counting as in flight.
PENDING_PAYMENT_TTL_MINUTES=30

# --- card-network simulator ---
CORE_API_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3001
WEB_URL=http://localhost:4321
CAPTURE_DELAY_MS=4000

# --- users created by the seed. `pnpm docker:up` replaces each <generate> password with a
# random 20-character one when it creates .env; no password has a default in code. With
# NODE_ENV=production the seed refuses a missing password, one under 12 characters or an unfilled
# placeholder (naming the key, never the value), and creates the demo customer only when
# SEED_DEMO_CUSTOMER=true. Keep SEED_DEMO_CUSTOMER=false in production. ---
SEED_ADMIN_EMAIL=admin@acme.test
SEED_ADMIN_PASSWORD=<generate>
SEED_CUSTOMER_EMAIL=ana@acme.test
SEED_CUSTOMER_PASSWORD=<generate>
SEED_DEMO_CUSTOMER=true

# --- web / admin demo helpers ("Usar cuenta demo" fills the sign-in form). Baked into the PUBLIC
# static bundles at build time: PUBLIC_DEMO_MODE MUST be false in production (the code default)
# and the four values below empty there. Locally, <same:KEY> copies the seed values above when
# `pnpm docker:up` creates .env, so the buttons sign in as the seeded users. The web bundle gets
# only the customer, the admin bundle only the admin. ---
PUBLIC_DEMO_MODE=true
PUBLIC_DEMO_EMAIL=<same:SEED_CUSTOMER_EMAIL>
PUBLIC_DEMO_PASSWORD=<same:SEED_CUSTOMER_PASSWORD>
PUBLIC_DEMO_ADMIN_EMAIL=<same:SEED_ADMIN_EMAIL>
PUBLIC_DEMO_ADMIN_PASSWORD=<same:SEED_ADMIN_PASSWORD>

# --- web and admin (public, baked into the static build) ---
PUBLIC_API_URL=http://localhost:3000
PUBLIC_NETWORK_URL=http://localhost:3001
# Absolute site URL for canonical links (defaults to the local port).
# SITE_URL=http://localhost:4321

---
/**
 * Profile (WA11): preferences are static (theme and language need no island); who is signed in,
 * sign out and closing the account are the private island.
 */
import LocaleSwitch from '@acme/ui/LocaleSwitch.astro';
import ThemeToggle from '@acme/ui/ThemeToggle.astro';
import { PageSkeleton } from '../../../app/components/PageSkeleton';
import Profile from '../../../app/features/profile/Profile';
import { getT, type Locale } from '../../../app/i18n';
import { localeSwitchLinks } from '../../../app/i18n/routing';
import { localeStaticPaths } from '../../../app/i18n/staticPaths';
import AppLayout from '../../../layouts/AppLayout.astro';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = getT(locale);
const localeLinks = localeSwitchLinks(Astro.url.pathname).map((link) => ({
  ...link,
  name: link.lang === 'en-US' ? t('prefs.english') : t('prefs.spanish'),
}));
---

<AppLayout title={t('meta.profileTitle')} heading={t('profile.pageTitle')} intro={t('profile.pageIntro')} locale={locale}>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:items-start lg:gap-8">
    <div class="min-w-0">
      <Profile client:only="react" locale={locale}>
        <PageSkeleton slot="fallback" label={t('profile.loading')} />
      </Profile>
    </div>
    <section aria-labelledby="prefs-title" class="flex flex-col items-start gap-5 rounded-card bg-lavender p-5 md:p-6">
      <h2 id="prefs-title" class="font-display text-h3 font-bold">{t('prefs.title')}</h2>
      <div class="flex flex-col gap-2">
        <span class="text-small font-semibold">{t('prefs.theme')}</span>
        <ThemeToggle label={t('prefs.theme')} lightLabel={t('prefs.light')} darkLabel={t('prefs.dark')} systemLabel={t('prefs.system')} />
      </div>
      <div class="flex flex-col gap-2">
        <span class="text-small font-semibold">{t('prefs.language')}</span>
        <LocaleSwitch label={t('prefs.languageSettings')} links={localeLinks} />
      </div>
    </section>
  </div>
</AppLayout>

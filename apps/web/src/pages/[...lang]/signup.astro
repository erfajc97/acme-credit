---
/** Sign up (noindex: an auth page, WA6). The form is interactive at once: client:load. */
import SignUp from '../../app/features/sign-up/SignUp';
import AuthShell from '../../components/AuthShell.astro';
import { getT, type Locale } from '../../app/i18n';
import { localizePath } from '../../app/i18n/routing';
import { localeStaticPaths } from '../../app/i18n/staticPaths';
import { ROUTES } from '../../app/lib/endpoints';
import PublicLayout from '../../layouts/PublicLayout.astro';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = getT(locale);
---

<PublicLayout title={t('meta.signUpTitle')} description={t('meta.signUpDescription')} locale={locale} noindex bare>
  <AuthShell locale={locale} heading={t('auth.signUp.title')} intro={t('auth.signUp.intro')} pose="celebrate" tone="lavender">
    <SignUp client:load locale={locale} />
    <p slot="footer" class="text-small text-fg">
      {t('auth.signUp.haveAccount')}{' '}
      <a href={localizePath(ROUTES.signIn, locale)} class="inline-flex min-h-11 items-center font-semibold text-fg underline decoration-2 underline-offset-4">{t('auth.signUp.signIn')}</a>
    </p>
  </AuthShell>
</PublicLayout>

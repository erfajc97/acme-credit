{
  "name": "@acme/card-network",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm --filter @acme/contracts --filter @acme/nest-core build && node --env-file-if-exists=../../.env --watch -r @swc-node/register src/main.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "openapi:export": "node --env-file-if-exists=../../.env -r @swc-node/register src/openapi-export.ts"
  },
  "dependencies": {
    "@acme/contracts": "workspace:*",
    "@acme/nest-core": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.18",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}

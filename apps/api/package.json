{
  "name": "@acme/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "scripts"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node scripts/start-prod.mjs",
    "start:worker": "node dist/worker.js",
    "dev": "pnpm --filter @acme/contracts --filter @acme/nest-core build && node --env-file-if-exists=../../.env --watch -r @swc-node/register src/main.ts",
    "dev:worker": "node --env-file-if-exists=../../.env -r @swc-node/register src/worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --script",
    "db:seed": "node --env-file-if-exists=../../.env -r @swc-node/register src/seed.ts",
    "bench:reads": "node -r @swc-node/register scripts/bench-reads.ts",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && vitest run --coverage",
    "test:integration": "prisma generate && vitest run -c vitest.integration.config.mts",
    "openapi:export": "node --env-file-if-exists=../../.env -r @swc-node/register src/openapi-export.ts"
  },
  "dependencies": {
    "@acme/contracts": "workspace:*",
    "@acme/nest-core": "workspace:*",
    "@aws-sdk/client-s3": "3.1154.0",
    "@aws-sdk/s3-request-presigner": "3.1154.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}

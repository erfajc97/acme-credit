---
/**
 * Credi strolling along a bottom edge once in a while: the animated walk crosses the screen in
 * ~12 s, then stays off-screen for the rest of a 40 s cycle (first pass after 8 s). Decorative
 * (aria-hidden), lazy and low priority, hidden under reduced motion. It never takes a tap: only a
 * mouse hover (fine pointers) reaches it, to pause it. Position the strip with `class` (e.g.
 * `bottom-0`, or above a tab bar); it is a fixed, full-width, 4.5rem-tall band.
 */
import { MASCOT_WALK_LOOP_SRC, MASCOT_WALK_SIZE } from './mascot/assets';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div aria-hidden="true" data-walking-mascot class={className}>
  <div data-walker>
    <img src={MASCOT_WALK_LOOP_SRC} alt="" width={MASCOT_WALK_SIZE} height={MASCOT_WALK_SIZE} loading="lazy" decoding="async" fetchpriority="low" />
  </div>
</div>

<style is:global>
  [data-walking-mascot] {
    position: fixed;
    inset-inline: 0;
    z-index: 30;
    height: 4.5rem;
    overflow: hidden;
    pointer-events: none;
  }

  [data-walker] {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 4.5rem;
    height: 4.5rem;
    translate: -5rem 0;
    animation: walking-mascot-stroll 40s linear 8s infinite;
  }

  [data-walker] img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (hover: hover) and (pointer: fine) {
    [data-walker] {
      pointer-events: auto;
    }

    [data-walker]:hover {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-walking-mascot] {
      display: none;
    }
  }

  @keyframes walking-mascot-stroll {
    0% {
      translate: -5rem 0;
    }

    30% {
      translate: calc(100vw + 1rem) 0;
    }

    100% {
      translate: calc(100vw + 1rem) 0;
    }
  }
</style>
